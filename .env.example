# Birdify Backend Environment Configuration Template
# Duplicate this file as .env and fill in the values for local development.

# Server Port
PORT=3000

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: http://localhost:3000,http://127.0.0.1:5500,https://<username>.github.io
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://ivanroko109.github.io

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Supabase Service Role Key (optional for local dev if anon has table grants, recommended for backend)
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID Keys
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<your-vapid-public-key-base64url>
VAPID_PRIVATE_KEY=<your-vapid-private-key-base64url>

# Contact subject for push notifications (mailto: or https: URL required by Web Push specification)
VAPID_SUBJECT=mailto:your-email@example.com
